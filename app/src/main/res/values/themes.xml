<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Nap511" parent="android:Theme.Material.Light.NoActionBar" />
    <!--全屏-->
    <style name="Theme.AppCompat.Light.NoActionBar.FullScreen" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- 完全透明且无切换动画的主题，防止隐式 Intent 触发时页面闪烁 -->
    <style name="Theme.TransparentNoAnimation" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- 启动屏专属主题，继承自 Theme.SplashScreen -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- 启动屏背景色（跟随系统当前日间/夜间背景色） -->
        <item name="windowSplashScreenBackground">?android:attr/colorBackground</item>
        <!-- 启动屏中心动态图标：云朵首尾流动轮廓 + 悬浮下载箭头 -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash_cloud</item>
        <!-- 动效周期时长，与 AVD 循环周期对齐 -->
        <item name="windowSplashScreenAnimationDuration">1800</item>
        <!-- 强制设置图标背景透明，杜绝系统默认底色与圆角形状伪影 -->
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <!-- 启动图退出后，Activity 自动无缝切换至主应用样式 -->
        <item name="postSplashScreenTheme">@style/Theme.AppCompat.Light.NoActionBar</item>
    </style>
</resources>