<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- 视频渲染 Surface -->
    <RelativeLayout
        android:id="@+id/surface_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center" />

    <!-- 封面图 -->
    <RelativeLayout
        android:id="@+id/thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:scaleType="fitCenter" />

    <!-- 顶部控制栏 (高度增至 56dp，兼顾横竖屏触摸热区) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_top"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/bg_top_gradient"
        android:paddingHorizontal="12dp">

        <!-- 返回按钮 -->
        <ImageView
            android:id="@+id/back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/video_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 视频标题 -->
        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/top_right_panel"
            app:layout_constraintStart_toEndOf="@+id/back"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="视频标题示例" />

        <!-- 顶部右侧整合面板：[比例胶囊] | [电量 时间] -->
        <LinearLayout
            android:id="@+id/top_right_panel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <!-- 播放倍速 (胶囊样式) -->
            <TextView
                android:id="@+id/switchSpeed"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_control_pill"
                android:gravity="center"
                android:minWidth="44dp"
                android:paddingHorizontal="10dp"
                android:text="倍速"
                android:textColor="@android:color/white"
                android:textSize="12sp" />
            <!-- 画面比例切换按钮 (胶囊样式) -->
            <TextView
                android:id="@+id/moreScale"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_control_pill"
                android:gravity="center"
                android:minWidth="44dp"
                android:paddingHorizontal="10dp"
                android:text="默认"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <!-- 系统状态显示区 -->
            <LinearLayout
                android:id="@+id/layout_status_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 竖向半透明分割线 -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="#33FFFFFF" />

                <TextView
                    android:id="@+id/batteryTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:typeface="monospace"
                    tools:text="98% ⚡" />

                <TextView
                    android:id="@+id/timeTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp"
                    android:typeface="monospace"
                    tools:text="14:30" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 播放与加载视图 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/startAndLoadLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <moe.codeest.enviews.ENDownloadView
            android:id="@+id/loading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 锁屏按钮 -->
    <ImageView
        android:id="@+id/lock_screen"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_circle_translucent"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/unlock"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/small_close"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_circle_translucent"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/video_small_close"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/back_tiny"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:padding="6dp"
        android:visibility="gone" />

    <!-- 底部控制栏 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_bottom"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_bottom_gradient"
        android:paddingHorizontal="12dp"
        android:paddingBottom="4dp"
        android:visibility="invisible">

        <!-- 第一行：当前时间、进度条、总时间 -->
        <TextView
            android:id="@+id/current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp"
            android:typeface="monospace"
            app:layout_constraintBottom_toTopOf="@+id/start"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="00:00" />

        <SeekBar
            android:id="@+id/progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="4dp"
            android:background="@null"
            android:max="100"
            android:maxHeight="3dp"
            android:minHeight="3dp"
            android:paddingVertical="10dp"
            android:progressDrawable="@drawable/video_seek_progress"
            android:splitTrack="false"
            android:thumb="@drawable/video_seek_thumb"
            app:layout_constraintBottom_toBottomOf="@+id/current"
            app:layout_constraintEnd_toStartOf="@+id/total"
            app:layout_constraintStart_toEndOf="@+id/current"
            app:layout_constraintTop_toTopOf="@+id/current" />

        <TextView
            android:id="@+id/total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            android:typeface="monospace"
            app:layout_constraintBottom_toBottomOf="@+id/current"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/current"
            tools:text="00:00" />

        <!-- 第二行：播放控制按钮与功能按钮 -->
        <ImageView
            android:id="@+id/prev_episode"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_skip_previous"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/start"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/video_click_play_selector"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/prev_episode" />

        <ImageView
            android:id="@+id/next_episode"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_skip_next"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/start" />

        <ImageView
            android:id="@+id/fullscreen"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/video_enlarge"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 选集按钮 (胶囊样式) -->
        <TextView
            android:id="@+id/switchEpisode"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_control_pill"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingHorizontal="10dp"
            android:text="选集"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/fullscreen"
            app:layout_constraintEnd_toStartOf="@+id/fullscreen"
            app:layout_constraintTop_toTopOf="@+id/fullscreen" />

        <!-- 字幕按钮 (胶囊样式) -->
        <TextView
            android:id="@+id/switchSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_control_pill"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingHorizontal="10dp"
            android:text="字幕"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/fullscreen"
            app:layout_constraintEnd_toStartOf="@+id/switchEpisode"
            app:layout_constraintTop_toTopOf="@+id/fullscreen" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 底部微型进度条 -->
    <ProgressBar
        android:id="@+id/bottom_progressbar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_alignParentBottom="true"
        android:max="100"
        android:progressDrawable="@drawable/video_progress" />

    <!-- 右侧通用抽屉面板 (290dp)，合并了选集、倍速、画面比例、字幕抽屉 -->
    <LinearLayout
        android:id="@+id/layout_drawer"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:background="#E6000000"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <!-- 抽屉头部标题及关闭按钮 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_drawer_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@+id/close_drawer"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="抽屉标题" />

            <ImageView
                android:id="@+id/close_drawer"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/video_small_close" />
        </RelativeLayout>

        <!-- 字幕专用的头部操作面板（包含自定义搜索、时间偏移微调、样式设置、移除字幕） -->
        <ScrollView
            android:id="@+id/layout_subtitle_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="220dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. 自定义搜索框栏 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/et_subtitle_search"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_control_pill"
                        android:hint="输入关健字搜索字幕"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:paddingHorizontal="10dp"
                        android:singleLine="true"
                        android:textColor="@android:color/white"
                        android:textColorHint="#80FFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btn_subtitle_search"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_control_pill"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="搜索"
                        android:textColor="#42A5F5"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 2. 时间偏移量微调栏 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_subtitle_offset_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#D0FFFFFF"
                        android:textSize="12sp"
                        tools:text="偏移: 0ms" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_offset_minus_1s"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_control_pill"
                            android:gravity="center"
                            android:paddingHorizontal="6dp"
                            android:text="-1s"
                            android:textColor="@android:color/white"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/btn_offset_minus_100ms"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_control_pill"
                            android:gravity="center"
                            android:paddingHorizontal="6dp"
                            android:text="-100ms"
                            android:textColor="@android:color/white"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/btn_offset_reset"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_control_pill"
                            android:gravity="center"
                            android:paddingHorizontal="6dp"
                            android:text="重置"
                            android:textColor="#42A5F5"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/btn_offset_plus_100ms"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_control_pill"
                            android:gravity="center"
                            android:paddingHorizontal="6dp"
                            android:text="+100ms"
                            android:textColor="@android:color/white"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/btn_offset_plus_1s"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_control_pill"
                            android:gravity="center"
                            android:paddingHorizontal="6dp"
                            android:text="+1s"
                            android:textColor="@android:color/white"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 3. 字幕样式设置栏 (字号、颜色) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="字号:"
                        android:textColor="#80FFFFFF"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btn_style_size_small"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_control_pill"
                        android:gravity="center"
                        android:paddingHorizontal="6dp"
                        android:text="小"
                        android:textColor="@android:color/white"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/btn_style_size_medium"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_control_pill"
                        android:gravity="center"
                        android:paddingHorizontal="6dp"
                        android:text="中"
                        android:textColor="#42A5F5"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/btn_style_size_large"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_control_pill"
                        android:gravity="center"
                        android:paddingHorizontal="6dp"
                        android:text="大"
                        android:textColor="@android:color/white"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="颜色:"
                        android:textColor="#80FFFFFF"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btn_style_color_white"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_control_pill"
                        android:gravity="center"
                        android:paddingHorizontal="6dp"
                        android:text="白"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/btn_style_color_yellow"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_control_pill"
                        android:gravity="center"
                        android:paddingHorizontal="6dp"
                        android:text="黄"
                        android:textColor="#FFEB3B"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/btn_style_color_green"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_control_pill"
                        android:gravity="center"
                        android:paddingHorizontal="6dp"
                        android:text="绿"
                        android:textColor="#4CAF50"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/btn_style_color_cyan"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_control_pill"
                        android:gravity="center"
                        android:paddingHorizontal="6dp"
                        android:text="青"
                        android:textColor="#00BCD4"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- 4. 字幕样式设置栏 (字体、加粗、底色) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="字体:"
                        android:textColor="#80FFFFFF"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/btn_style_font_default"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_control_pill"
                        android:gravity="center"
                        android:paddingHorizontal="5dp"
                        android:text="默认"
                        android:textColor="#42A5F5"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/btn_style_font_sans"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/bg_control_pill"
                        android:gravity="center"
                        android:paddingHorizontal="5dp"
                        android:text="无衬线"
                        android:textColor="@android:color/white"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/btn_style_font_serif"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/bg_control_pill"
                        android:gravity="center"
                        android:paddingHorizontal="5dp"
                        android:text="衬线"
                        android:textColor="@android:color/white"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/btn_style_font_mono"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/bg_control_pill"
                        android:gravity="center"
                        android:paddingHorizontal="5dp"
                        android:text="等宽"
                        android:textColor="@android:color/white"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/btn_style_bold"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_control_pill"
                        android:gravity="center"
                        android:paddingHorizontal="6dp"
                        android:text="加粗"
                        android:textColor="@android:color/white"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/btn_style_bg_translucent"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_control_pill"
                        android:gravity="center"
                        android:paddingHorizontal="6dp"
                        android:text="半透底"
                        android:textColor="@android:color/white"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_save_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_control_pill"
                    android:gravity="center"
                    android:text="保存当前字幕"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />

                <!-- 5. 移除当前字幕按钮 -->
                <TextView
                    android:id="@+id/btn_remove_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_control_pill"
                    android:gravity="center"
                    android:text="移除当前字幕"
                    android:textColor="#FF5252"
                    android:textSize="12sp" />

                <!-- 分割线 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="8dp"
                    android:background="#33FFFFFF" />
            </LinearLayout>
        </ScrollView>

        <!-- 列表容器：利用 FrameLayout 权重填充剩余空间 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 字幕为空或加载状态提示文本 -->
            <TextView
                android:id="@+id/tv_subtitle_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="20dp"
                android:textColor="#80FFFFFF"
                android:textSize="13sp"
                android:visibility="gone"
                tools:text="未找到匹配字幕，请输入关键字重新搜索" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_drawer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:overScrollMode="never"
                android:scrollbars="vertical" />
        </FrameLayout>
    </LinearLayout>

</RelativeLayout>