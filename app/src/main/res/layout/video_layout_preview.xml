<?xml version="1.0" encoding="utf-8"?>
<!-- 播放器主界面布局 (已拆分为顶部栏、底部栏和右侧抽屉三个独立模块) -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- 1. 视频渲染 Surface 容器 -->
    <RelativeLayout
        android:id="@+id/surface_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center" />

    <!-- 2. 视频封面图 -->
    <RelativeLayout
        android:id="@+id/thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:scaleType="fitCenter" />

    <!-- 3. 顶部控制栏 (独立模块: layout_video_top.xml) -->
    <include layout="@layout/layout_video_top" />

    <!-- 4. 播放与加载状态视图 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/startAndLoadLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <moe.codeest.enviews.ENDownloadView
            android:id="@+id/loading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 5. 悬浮/独立操作按钮 -->
    <!-- 屏幕锁按键 -->
    <ImageView
        android:id="@+id/lock_screen"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_circle_translucent"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/unlock"
        android:visibility="gone" />

    <!-- 小窗口/浮窗模式关闭按钮 -->
    <ImageView
        android:id="@+id/small_close"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_circle_translucent"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/video_small_close"
        android:visibility="gone" />

    <!-- 迷你模式返回按钮 -->
    <ImageView
        android:id="@+id/back_tiny"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:padding="6dp"
        android:visibility="gone" />

    <!-- 6. 底部控制栏 (独立模块: layout_video_bottom.xml) -->
    <include layout="@layout/layout_video_bottom" />

    <!-- 7. 底部微型进度条 (控制栏隐藏时显示) -->
    <ProgressBar
        android:id="@+id/bottom_progressbar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_alignParentBottom="true"
        android:max="100"
        android:progressDrawable="@drawable/video_progress" />

    <!-- 8. 右侧通用抽屉面板 (独立模块: layout_video_drawer.xml) -->
    <include layout="@layout/layout_video_drawer" />

</RelativeLayout>