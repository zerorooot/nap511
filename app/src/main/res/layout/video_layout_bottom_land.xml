<?xml version="1.0" encoding="utf-8"?>
<!-- 播放器横屏底部控制栏 (悬浮玻璃卡片 Floating Glass Dock + 两行式黄金排版) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_bottom"
    android:layout_width="match_parent"
    android:layout_height="82dp"
    android:layout_alignParentBottom="true"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_bottom_glass_dock"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <!-- 第一行：当前播放时间 -->
    <TextView
        android:id="@+id/current"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:textColor="#E6FFFFFF"
        android:textSize="12sp"
        android:typeface="monospace"
        app:layout_constraintBottom_toTopOf="@+id/start"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 第一行：大跨度全宽拖动进度条 (SeekBar) -->
    <SeekBar
        android:id="@+id/progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginHorizontal="10dp"
        android:background="@null"
        android:max="100"
        android:maxHeight="3dp"
        android:minHeight="3dp"
        android:paddingVertical="10dp"
        android:progressDrawable="@drawable/video_seek_progress"
        android:splitTrack="false"
        android:thumb="@drawable/video_seek_thumb"
        app:layout_constraintBottom_toBottomOf="@+id/current"
        app:layout_constraintEnd_toStartOf="@+id/total"
        app:layout_constraintStart_toEndOf="@+id/current"
        app:layout_constraintTop_toTopOf="@+id/current" />

    <!-- 第一行：视频总时间 -->
    <TextView
        android:id="@+id/total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:textColor="#80FFFFFF"
        android:textSize="12sp"
        android:typeface="monospace"
        app:layout_constraintBottom_toBottomOf="@+id/current"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/current" />

    <!-- 第二行：中间核心播控区（视觉重心：44dp 居中放大播放/暂停按键） -->
    <ImageView
        android:id="@+id/start"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_play_center_circle"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/video_click_play_selector"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 第二行：上一集图标按钮 (居中按键左侧) -->
    <ImageView
        android:id="@+id/prev_episode"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="4dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_skip_previous"
        app:layout_constraintBottom_toBottomOf="@+id/start"
        app:layout_constraintEnd_toStartOf="@+id/start"
        app:layout_constraintTop_toTopOf="@+id/start" />

    <!-- 第二行：下一集图标按钮 (居中按键右侧) -->
    <ImageView
        android:id="@+id/next_episode"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="4dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_skip_next"
        app:layout_constraintBottom_toBottomOf="@+id/start"
        app:layout_constraintStart_toEndOf="@+id/start"
        app:layout_constraintTop_toTopOf="@+id/start" />

    <!-- 第二行：全屏/窗口切换按键 (右侧靠边) -->
    <ImageView
        android:id="@+id/fullscreen"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="4dp"
        android:scaleType="centerInside"
        android:src="@drawable/video_enlarge"
        app:layout_constraintBottom_toBottomOf="@+id/start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/start" />

    <!-- 第二行：选集按钮 (胶囊样式，右侧区) -->
    <TextView
        android:id="@+id/switchEpisode"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_control_pill"
        android:gravity="center"
        android:minWidth="44dp"
        android:paddingHorizontal="10dp"
        android:text="选集"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/start"
        app:layout_constraintEnd_toStartOf="@+id/fullscreen"
        app:layout_constraintTop_toTopOf="@+id/start" />

    <!-- 第二行：字幕设置抽屉按钮 (胶囊样式，右侧区) -->
    <TextView
        android:id="@+id/switchSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_control_pill"
        android:gravity="center"
        android:minWidth="44dp"
        android:paddingHorizontal="10dp"
        android:text="字幕"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/start"
        app:layout_constraintEnd_toStartOf="@+id/switchEpisode"
        app:layout_constraintTop_toTopOf="@+id/start" />

</androidx.constraintlayout.widget.ConstraintLayout>